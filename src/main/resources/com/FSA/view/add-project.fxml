<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.PasswordField?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.FSA.AddProjectController" styleClass="form-box">

    <VBox styleClass="form-field">
        <Label text="Project name" styleClass="form-label"/>
        <TextField fx:id="nameField" promptText="e.g. Villa Lux" styleClass="form-input"/>
    </VBox>

    <HBox styleClass="form-row">
        <VBox styleClass="form-field" HBox.hgrow="ALWAYS">
            <Label text="Location of the site" styleClass="form-label"/>
            <TextField fx:id="locationField" promptText="e.g. Rabat" styleClass="form-input"/>
        </VBox>
        <VBox styleClass="form-field" HBox.hgrow="ALWAYS">
            <Label text="Budget (DH)" styleClass="form-label"/>
            <TextField fx:id="budgetField" promptText="e.g. 500000" styleClass="form-input"/>
        </VBox>
    </HBox>

    <HBox styleClass="form-row">
        <VBox styleClass="form-field" HBox.hgrow="ALWAYS">
            <Label text="Start date" styleClass="form-label"/>
            <DatePicker fx:id="startPicker" maxWidth="Infinity"/>
        </VBox>
        <VBox styleClass="form-field" HBox.hgrow="ALWAYS">
            <Label text="Finish date" styleClass="form-label"/>
            <DatePicker fx:id="endPicker" maxWidth="Infinity"/>
        </VBox>
    </HBox>

    <VBox styleClass="form-field">
        <Label text="Chef de projet (optional)" styleClass="form-label"/>
        <HBox spacing="10">
            <TextField fx:id="firstNameField" promptText="First name" HBox.hgrow="ALWAYS" styleClass="form-input"/>
            <TextField fx:id="lastNameField"  promptText="Last name"  HBox.hgrow="ALWAYS" styleClass="form-input"/>
        </HBox>
        <PasswordField fx:id="passwordField" promptText="Password (min. 6 characters)" styleClass="form-input"/>
        <Label fx:id="emailPreview" text="Leave empty: the project will wait for a chef" styleClass="form-hint"/>
    </VBox>

    <VBox styleClass="form-field">
        <Label text="Image" styleClass="form-label"/>
        <HBox styleClass="form-row" alignment="CENTER_LEFT">
            <Button fx:id="chooseImageButton" text="Choose image..." styleClass="form-cancel"/>
            <Label fx:id="imageName" text="No image selected" styleClass="form-hint"/>
            <Region HBox.hgrow="ALWAYS"/>
            <ImageView fx:id="preview" fitHeight="48.0" preserveRatio="true"/>
        </HBox>
    </VBox>

    <Label fx:id="errorLabel" styleClass="form-error" wrapText="true"
           visible="false" managed="false"/>

    <HBox styleClass="form-row" alignment="CENTER_RIGHT">
        <Button fx:id="cancelButton" text="Cancel" styleClass="form-cancel"/>
        <Button fx:id="createButton" text="Create project" styleClass="add-btn"/>
    </HBox>
</VBox>