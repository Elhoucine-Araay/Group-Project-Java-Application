<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.FSA.chefprojectController" fx:id="root"
           prefWidth="1280.0" prefHeight="720.0"
           styleClass="root-pane">

   <!-- dashboard.css = sidebar + page colours (shared), home.css = the cards on this page -->
   <stylesheets>
      <URL value="@../css/dashboard.css"/>
      <URL value="@../css/chefproject.css"/>
   </stylesheets>

   <!-- ============ MAIN AREA (left padding = width of the icon rail) ============ -->
   <VBox styleClass="main" minWidth="0.0">

      <Label text="Dashboard" styleClass="page-title"/>

      <GridPane styleClass="dash-grid" VBox.vgrow="ALWAYS">
         <columnConstraints>
            <ColumnConstraints percentWidth="50.0" hgrow="ALWAYS" minWidth="0.0"/>
            <ColumnConstraints percentWidth="50.0" hgrow="ALWAYS" minWidth="0.0"/>
         </columnConstraints>
         <rowConstraints>
            <RowConstraints percentHeight="50.0" vgrow="ALWAYS" minHeight="0.0"/>
            <RowConstraints percentHeight="50.0" vgrow="ALWAYS" minHeight="0.0"/>
         </rowConstraints>

         <!-- ===== Attendance ===== -->
         <VBox fx:id="attendanceCard" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="dash-card" minWidth="0.0" minHeight="0.0">
            <Label text="Attendance" styleClass="dash-card-title"/>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="col-scroll" VBox.vgrow="ALWAYS">
               <content>
                  <VBox fx:id="attendanceList"/>
               </content>
            </ScrollPane>
         </VBox>

         <!-- ===== Materials Inventory ===== -->
         <VBox fx:id="materialsCard" GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="dash-card" minWidth="0.0" minHeight="0.0">
            <Label text="Materials Inventory" styleClass="dash-card-title"/>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="col-scroll" VBox.vgrow="ALWAYS">
               <content>
                  <VBox fx:id="materialsList"/>
               </content>
            </ScrollPane>
         </VBox>

         <!-- ===== Equipment Status ===== -->
         <VBox fx:id="equipmentCard" GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="dash-card" minWidth="0.0" minHeight="0.0">
            <Label text="Equipment Status" styleClass="dash-card-title"/>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="col-scroll" VBox.vgrow="ALWAYS">
               <content>
                  <VBox fx:id="equipmentList"/>
               </content>
            </ScrollPane>
         </VBox>

         <!-- ===== Budget Status ===== -->
         <VBox fx:id="budgetCard" GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="dash-card, budget-card" minWidth="0.0" minHeight="0.0">

            <HBox alignment="CENTER_LEFT">
               <Label text="Budget Status" styleClass="dash-card-title"/>
               <Region HBox.hgrow="ALWAYS"/>
               <Label fx:id="budgetPill" text="On track" styleClass="pill, pill-ok">
                  <graphic><Region styleClass="pill-dot"/></graphic>
               </Label>
            </HBox>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox styleClass="budget-block">
               <Label text="Total Project Budget" styleClass="budget-label"/>
               <Label fx:id="totalBudgetLabel" text="0 DH" styleClass="budget-total"/>
            </VBox>

            <HBox styleClass="budget-split">
               <VBox HBox.hgrow="ALWAYS" styleClass="budget-block">
                  <Label text="Spent" styleClass="budget-label"/>
                  <Label fx:id="spentLabel" text="0 DH" styleClass="budget-spent"/>
               </VBox>
               <VBox HBox.hgrow="ALWAYS" styleClass="budget-block">
                  <Label text="Remaining" styleClass="budget-label"/>
                  <Label fx:id="remainingLabel" text="0 DH" styleClass="budget-remaining"/>
               </VBox>
            </HBox>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox styleClass="budget-block">
               <HBox alignment="CENTER_LEFT">
                  <Label text="Budget used" styleClass="budget-used-label"/>
                  <Region HBox.hgrow="ALWAYS"/>
                  <Label fx:id="usedPercentLabel" text="0%" styleClass="budget-used-percent"/>
               </HBox>
               <StackPane fx:id="budgetBar" styleClass="bar-track, bar-lg" alignment="CENTER_LEFT">
                  <Region fx:id="budgetFill" styleClass="bar-fill, bar-budget"/>
               </StackPane>
               <HBox styleClass="budget-note" alignment="CENTER_LEFT">
                  <Region styleClass="icon-trend"/>
                  <Label fx:id="remainsLabel" text="" styleClass="budget-label"/>
               </HBox>
            </VBox>
         </VBox>

      </GridPane>
   </VBox>

   <!-- ============ SIDEBAR: icon rail that expands over the page on hover ============ -->
   <StackPane fx:id="sidebar" styleClass="sidebar" alignment="TOP_LEFT" StackPane.alignment="TOP_LEFT">
      <VBox fx:id="sidebarContent" styleClass="sidebar-content">

         <!-- Profile (top) + settings button -->
         <HBox styleClass="profile" alignment="CENTER_LEFT">
            <StackPane styleClass="avatar">
               <Label fx:id="avatarText" text="EA" styleClass="avatar-text"/>
            </StackPane>
            <VBox styleClass="profile-text" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" minWidth="0.0">
               <Label fx:id="profileName" text="Elhoucine Araay" styleClass="profile-name"/>
               <Label fx:id="profileEmail" text="Elhoucine.Araay@csm.com" styleClass="profile-email"/>
            </VBox>
            <Button fx:id="settingsButton" styleClass="icon-btn" minWidth="0.0">
               <graphic><Region styleClass="icon-gear"/></graphic>
            </Button>
         </HBox>

         <!-- Navigation -->
         <Button fx:id="dashboardButton" text="Dashboard" maxWidth="Infinity" minWidth="0.0"
                 styleClass="nav-item, nav-active">
            <graphic><Region styleClass="nav-icon, icon-home"/></graphic>
         </Button>

         <Button fx:id="projectsButton" text="Projects" maxWidth="Infinity" minWidth="0.0"
                 styleClass="nav-item">
            <graphic><Region styleClass="nav-icon, icon-folder"/></graphic>
         </Button>

         <Button fx:id="notificationsButton" text="Notifications" maxWidth="Infinity" minWidth="0.0"
                 styleClass="nav-item">
            <graphic><Region styleClass="nav-icon, icon-bell"/></graphic>
         </Button>

         <Button fx:id="reportsButton" text="Reports" maxWidth="Infinity" minWidth="0.0"
                 styleClass="nav-item">
            <graphic><Region styleClass="nav-icon, icon-chart"/></graphic>
         </Button>

         <Button fx:id="teamButton" text="Team" maxWidth="Infinity" minWidth="0.0"
                 styleClass="nav-item">
            <graphic><Region styleClass="nav-icon, icon-people"/></graphic>
         </Button>

         <Region VBox.vgrow="ALWAYS"/>

         <!-- Bottom -->
         <Region styleClass="sidebar-sep"/>

         <Button fx:id="logoutButton" text="Logout" maxWidth="Infinity" minWidth="0.0"
                 styleClass="nav-item">
            <graphic><Region styleClass="nav-icon, icon-logout"/></graphic>
         </Button>

         <HBox fx:id="themeRow" styleClass="nav-row, theme-row" alignment="CENTER_LEFT">
            <Region styleClass="nav-icon, icon-moon"/>
            <Label text="Dark Mode" styleClass="nav-label"/>
            <Region HBox.hgrow="ALWAYS"/>
            <StackPane fx:id="themeSwitch" styleClass="switch-track" alignment="CENTER_LEFT">
               <Region styleClass="switch-thumb"/>
            </StackPane>
         </HBox>

      </VBox>
   </StackPane>
   <!-- ============ POP-UP LAYER: covers the page, hidden until a box is clicked ============ -->
   <StackPane fx:id="popupLayer" styleClass="popup-layer" visible="false">
      <VBox fx:id="popupCard" styleClass="popup-card">
         <HBox alignment="CENTER_LEFT">
            <Label fx:id="popupTitle" styleClass="popup-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="popupClose" text="✕" styleClass="popup-close"/>
         </HBox>
         <VBox fx:id="popupContent" styleClass="popup-content" VBox.vgrow="ALWAYS"/>
      </VBox>
   </StackPane>
</StackPane>
